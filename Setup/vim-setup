#!/usr/bin/env bash
set -euo pipefail

echo "NeoVim & NeoVim Plugins"

mkdir -p ~/bin
cd ~/bin

curl -sLO https://github.com/neovim/neovim/releases/download/v0.11.0/nvim-macos-arm64.tar.gz
tar xzf nvim-macos-arm64.tar.gz --strip-components=1
rm nvim-macos-arm64.tar.gz

rm -rf ~/.config/nvim
mkdir -p ~/.config
ln -sf ~/.dotfiles/.config/nvim ~/.config/nvim

export PATH="$HOME/bin/bin:$PATH"
nvim --headless -u ~/.config/nvim/init.lua '+Lazy! sync' '+qall'

