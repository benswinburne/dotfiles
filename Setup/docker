#!/usr/bin/env bash
set -euo pipefail

echo "Setup Docker"

# ECR credentials from Dropbox
mkdir -p ~/.docker
ln -sf ~/Dropbox/.docker/config.json ~/.docker/config.json

mkdir -p ~/.docker/cli-plugins
ln -sfn $(brew --prefix)/opt/docker-compose/bin/docker-compose ~/.docker/cli-plugins/docker-compose
ln -sfn $(brew --prefix)/opt/docker-buildx/bin/docker-buildx ~/.docker/cli-plugins/docker-buildx

colima start || true

# Wait for docker to be available
for i in {1..30}; do
  if docker ps >/dev/null 2>&1; then
    break
  fi
  sleep 2
done

# Bash completions (after colima start so docker command is available)
mkdir -p ~/.local/share/bash-completion/completions
docker completion bash > ~/.local/share/bash-completion/completions/docker

# Enable auto-start (ignore if already loaded)
brew services start colima 2>/dev/null || true

